# Copy to .env (gitignored, never committed) and fill in. Sourced by the shell,
# so keep the single quotes around values with special characters.

# Server hostname rather than ftp.ivonliu.com: the FTP TLS certificate is for
# *.web-hosting.com. If Namecheap moves the account, find the new name with
#   dig +short -x "$(dig +short ftp.ivonliu.com)"
FTP_HOST='server177-1.web-hosting.com'
FTP_USER=''
FTP_PASSWORD=''

# Server web root that local public_html/ mirrors, relative to the FTP login
# directory: 'public_html' for the main cPanel account, '.' for an FTP account whose
# home directory is already public_html.
FTP_REMOTE_DIR='.'
